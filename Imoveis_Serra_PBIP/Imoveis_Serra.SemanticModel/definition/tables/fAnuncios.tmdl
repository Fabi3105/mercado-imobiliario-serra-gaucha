	partition fAnuncios = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "\dados\anuncios_tratados.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    SemBOM = Table.TransformColumnNames(Cabecalho, each Text.Trim(_, {"#(FEFF)", " "})),
				    Selecao = Table.SelectColumns(SemBOM, {"id", "data_coleta", "cidade", "bairro", "categoria", "em_condominio", "tipologia", "preco_pedido", "area_m2", "preco_m2", "quartos", "banheiros", "vagas", "faixa_preco"}),
				    Tipos = Table.TransformColumnTypes(Selecao, {{"id", Int64.Type}, {"data_coleta", type date}, {"cidade", type text}, {"bairro", type text}, {"categoria", type text}, {"em_condominio", type text}, {"tipologia", type text}, {"preco_pedido", type number}, {"area_m2", type number}, {"preco_m2", type number}, {"quartos", type number}, {"banheiros", type number}, {"vagas", type number}, {"faixa_preco", type text}}, "pt-BR"),
				    Condominio = Table.TransformColumns(Tipos, {{"em_condominio", each if _ = "True" then "Sim" else "Não", type text}}),
				    Final = Table.AddColumn(Condominio, "faixa_ordem", each List.PositionOf({"até 300 mil", "300 a 500 mil", "500 a 750 mil", "750 mil a 1 mi", "1 a 1,5 mi", "1,5 a 2,5 mi", "acima de 2,5 mi"}, [faixa_preco]) + 1, Int64.Type),
				    Curta = Table.AddColumn(Final, "tipologia_curta", each Text.Replace(Text.Replace([tipologia], "Apartamento", "Apto"), "quartos não informados", "s/ quartos"), type text),
				    Local = Table.AddColumn(Curta, "local_mapa", each [bairro] & ", " & [cidade] & ", RS, Brasil", type text),
				    Resultado = Local
				in
				    Resultado

	annotation PBI_ResultType = Table

