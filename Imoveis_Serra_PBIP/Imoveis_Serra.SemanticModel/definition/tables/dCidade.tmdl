	partition dCidade = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "\dados\publicar\domicilios_censo.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    SemBOM = Table.TransformColumnNames(Cabecalho, each Text.Trim(_, {"#(FEFF)", " "})),
				    Selecao = Table.SelectColumns(SemBOM, {"cidade", "casas_2010", "apartamentos_2010", "total_2010", "casas_2022", "apartamentos_2022", "total_2022", "moradores_por_domicilio_2022", "casas_novos_por_ano", "casas_cresc_aa_pct", "casas_2031_se_ritmo_mantido", "apartamentos_novos_por_ano", "apartamentos_cresc_aa_pct", "apartamentos_2031_se_ritmo_mantido", "total_novos_por_ano", "total_cresc_aa_pct", "total_2031_se_ritmo_mantido", "pct_apartamentos_2010", "pct_apartamentos_2022"}),
				    Tipos = Table.TransformColumnTypes(Selecao, {{"cidade", type text}, {"casas_2010", type number}, {"apartamentos_2010", type number}, {"total_2010", type number}, {"casas_2022", type number}, {"apartamentos_2022", type number}, {"total_2022", type number}, {"moradores_por_domicilio_2022", type number}, {"casas_novos_por_ano", type number}, {"casas_cresc_aa_pct", type number}, {"casas_2031_se_ritmo_mantido", type number}, {"apartamentos_novos_por_ano", type number}, {"apartamentos_cresc_aa_pct", type number}, {"apartamentos_2031_se_ritmo_mantido", type number}, {"total_novos_por_ano", type number}, {"total_cresc_aa_pct", type number}, {"total_2031_se_ritmo_mantido", type number}, {"pct_apartamentos_2010", type number}, {"pct_apartamentos_2022", type number}}, "pt-BR"),
				    Coords = [#"Caxias do Sul" = {-29.1678, -51.1794}, #"Bento Gonçalves" = {-29.1714, -51.5192}, #"Gramado" = {-29.3787, -50.874}, #"Canela" = {-29.365, -50.8117}, #"Nova Petrópolis" = {-29.3761, -51.1136}, #"Farroupilha" = {-29.225, -51.3478}, #"Garibaldi" = {-29.2564, -51.5336}, #"Carlos Barbosa" = {-29.2976, -51.5036}, #"Flores da Cunha" = {-29.0286, -51.1819}],
				    ComLat = Table.AddColumn(Tipos, "latitude", each Record.FieldOrDefault(Coords, [cidade], {null, null}){0}, type number),
				    Local = Table.AddColumn(ComLat, "longitude", each Record.FieldOrDefault(Coords, [cidade], {null, null}){1}, type number),
				    Resultado = Local
				in
				    Resultado

	annotation PBI_ResultType = Table

