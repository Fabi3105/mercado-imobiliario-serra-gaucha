# Publica só o que está liberado abaixo; o resto (base de anúncios, fontes baixadas, rascunhos) fica no computador
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/ROTEIRO_POWER_BI.md
!/painel_power_bi.pdf
!/scripts/
!/Imoveis_Serra_PBIP/
!/dados/
/dados/*
!/dados/publicar/
Imoveis_Serra_PBIP/**/.pbi/
__pycache__/
*.pyc
